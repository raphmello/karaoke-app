# The only service exposed on the PC (port 8080), on the home network and, with the "remote" profile, through the
# Cloudflare Tunnel. /internal is never routed: only the worker (and Caddy's own forward_auth) reach it.
{
	servers {
		# cloudflared reaches Caddy over Docker's private network: trust its X-Forwarded-* headers, so the API sees
		# that the original connection is HTTPS (and marks its cookies Secure)
		trusted_proxies static private_ranges
	}
}

:8080 {
	encode zstd gzip

	# The bare address opens the TV; the host reaches /host from there. Temporary (302), so browsers don't keep it
	# for good if the landing page ever changes.
	redir / /tv 302

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /ws/* {
		reverse_proxy api:8000
	}

	# Audio and lyrics straight from the volume, read-only, for the host and the guests of an open room only (the
	# API checks the cookie). file_server answers Range requests, which the browser needs to seek. "private" keeps
	# Cloudflare from caching them, which would hand them to anyone.
	handle_path /media/* {
		forward_auth api:8000 {
			uri /internal/media-auth
		}
		header Cache-Control "private, max-age=86400"
		root * /srv/karaoke/media
		file_server
	}

	# The frontend, built into the image. Routes like /tv are the app's own: they all get index.html.
	# index.html is always revalidated, so an update reaches the TV and the phones on the next load; the
	# bundles in /assets carry a hash in their names and never change.
	handle {
		root * /srv/web
		@assets path /assets/*
		@pages not path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header @pages Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
