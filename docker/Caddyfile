# The only service exposed on the PC (port 8080). /internal is never routed: only the worker reaches it.
:8080 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /ws/* {
		reverse_proxy api:8000
	}

	# Audio and lyrics straight from the volume, read-only. file_server answers Range requests, which the
	# browser needs to seek.
	handle_path /media/* {
		root * /srv/karaoke/media
		file_server
	}

	# The frontend, built into the image. Routes like /tv are the app's own: they all get index.html.
	# index.html is always revalidated, so an update reaches the TV and the phones on the next load; the
	# bundles in /assets carry a hash in their names and never change.
	handle {
		root * /srv/web
		@assets path /assets/*
		@pages not path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header @pages Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
