# Copy to .env and fill in. docker compose reads it.

# PIN the host uses to log in at /host.
HOST_PIN=

# Address the phones use to reach the app; the QR code always uses it when set.
# With the Cloudflare Tunnel: https://karaoke.<your-domain>. Home network only: http://<PC's IP>:8080
PUBLIC_BASE_URL=

# Token of the Cloudflare Tunnel (Cloudflare dashboard > Zero Trust > Networks > Tunnels), for
# `docker compose --profile remote up -d`. Keep it secret.
CLOUDFLARE_TUNNEL_TOKEN=
